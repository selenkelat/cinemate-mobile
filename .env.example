# Copy to .env and adjust for how you're running the backend.
#
# Android emulator (backend on the host machine): the emulator's virtual NIC maps the host as
# 10.0.2.2, never `localhost` (that resolves to the emulator itself).
EXPO_PUBLIC_API_URL=http://10.0.2.2:5080

# Physical device over Expo Go (same Wi-Fi as the host machine): use the host's LAN IP, and start
# the backend with `dotnet run --urls http://0.0.0.0:5080` so it isn't loopback-only.
# EXPO_PUBLIC_API_URL=http://192.168.1.100:5080

# iOS simulator only (requires a Mac): the simulator shares the host's loopback interface.
# EXPO_PUBLIC_API_URL=http://localhost:5080
